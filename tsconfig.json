{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // Zero-dependency correctness checks. These catch the class of mistake
    // that actually occurs here — dead bindings left behind by a refactor,
    // and switch cases that fall through while parsing agent protocols —
    // rather than formatting opinions.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true
  },
  // Tests are typechecked too: `dist` is emitted from tsconfig.build.json,
  // which excludes them. Leaving tests out here let `test/server.test.ts` keep
  // referencing the removed `done` / `html` events without CI noticing.
  "include": ["src", "test"]
}
